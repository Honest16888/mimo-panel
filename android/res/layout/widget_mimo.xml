<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <!-- 横版：余额在左，走势在右 -->
    <LinearLayout
        android:id="@+id/box_wide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MiMo 余额"
                android:textSize="11sp"
                android:textColor="#8b93a1" />

            <TextView
                android:id="@+id/wide_bal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="—"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#ff9f2e" />

            <TextView
                android:id="@+id/wide_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="读取中…"
                android:textSize="11sp"
                android:textColor="#a8b0bf" />

            <TextView
                android:id="@+id/wide_sub2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="#8b93a1" />
        </LinearLayout>

        <ImageView
            android:id="@+id/wide_chart"
            android:layout_width="118dp"
            android:layout_height="66dp"
            android:layout_marginLeft="10dp"
            android:scaleType="fitXY"
            android:contentDescription="近 14 天消费走势" />
    </LinearLayout>

    <!-- 方形：余额在上，走势铺满下沿 -->
    <LinearLayout
        android:id="@+id/box_square"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MiMo 余额"
            android:textSize="11sp"
            android:textColor="#8b93a1" />

        <TextView
            android:id="@+id/sq_bal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="—"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#ff9f2e" />

        <TextView
            android:id="@+id/sq_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="读取中…"
            android:textSize="11sp"
            android:textColor="#a8b0bf" />

        <ImageView
            android:id="@+id/sq_chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:scaleType="fitXY"
            android:contentDescription="近 14 天消费走势" />
    </LinearLayout>

    <!-- 迷你：只剩数字 -->
    <LinearLayout
        android:id="@+id/box_mini"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/mini_bal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#ff9f2e" />

        <TextView
            android:id="@+id/mini_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textSize="10sp"
            android:textColor="#8b93a1" />
    </LinearLayout>
</FrameLayout>
